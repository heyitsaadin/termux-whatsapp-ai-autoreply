<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android='http://schemas.android.com/apk/res/android'
    xmlns:app='http://schemas.android.com/apk/res-auto'
    android:layout_width='match_parent'
    android:layout_height='match_parent'
    android:background='?attr/colorSurface'
    android:fillViewport='true'>

    <LinearLayout
        android:layout_width='match_parent'
        android:layout_height='wrap_content'
        android:orientation='vertical'
        android:paddingHorizontal='20dp'
        android:paddingTop='40dp'
        android:paddingBottom='32dp'>

        <TextView
            android:layout_width='match_parent'
            android:layout_height='wrap_content'
            android:text='Status Auto-Reply'
            android:textAppearance='?attr/textAppearanceHeadlineLarge'
            android:textColor='?attr/colorOnSurface'
            android:textStyle='bold' />

        <TextView
            android:layout_width='match_parent'
            android:layout_height='wrap_content'
            android:layout_marginTop='4dp'
            android:layout_marginBottom='24dp'
            android:text='Answers WhatsApp using your /tag status'
            android:textAppearance='?attr/textAppearanceBodyLarge'
            android:textColor='?attr/colorOnSurfaceVariant' />

        <com.google.android.material.card.MaterialCardView
            android:id='@+id/heroCard'
            style='@style/Widget.Material3.CardView.Filled'
            android:layout_width='match_parent'
            android:layout_height='wrap_content'
            android:layout_marginBottom='28dp'
            app:cardCornerRadius='40dp'
            app:cardElevation='0dp'>

            <LinearLayout
                android:layout_width='match_parent'
                android:layout_height='wrap_content'
                android:orientation='vertical'
                android:padding='28dp'>

                <ImageView
                    android:id='@+id/heroIcon'
                    android:layout_width='48dp'
                    android:layout_height='48dp'
                    android:importantForAccessibility='no' />

                <TextView
                    android:id='@+id/heroTitle'
                    android:layout_width='match_parent'
                    android:layout_height='wrap_content'
                    android:layout_marginTop='16dp'
                    android:textAppearance='?attr/textAppearanceDisplaySmall'
                    android:textStyle='bold' />

                <TextView
                    android:id='@+id/heroSub'
                    android:layout_width='match_parent'
                    android:layout_height='wrap_content'
                    android:layout_marginTop='6dp'
                    android:textAppearance='?attr/textAppearanceBodyLarge' />

                <com.google.android.material.button.MaterialButton
                    android:id='@+id/heroButton'
                    android:layout_width='match_parent'
                    android:layout_height='64dp'
                    android:layout_marginTop='24dp'
                    android:textSize='18sp'
                    android:textStyle='bold'
                    app:cornerRadius='32dp'
                    app:iconGravity='textStart'
                    app:iconPadding='12dp' />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width='match_parent'
            android:layout_height='wrap_content'
            android:layout_marginBottom='12dp'
            android:text='Permissions and services'
            android:textAppearance='?attr/textAppearanceTitleLarge'
            android:textColor='?attr/colorOnSurface'
            android:textStyle='bold' />

        <include
            android:id='@+id/rowListener'
            layout='@layout/item_status' />

        <include
            android:id='@+id/rowBattery'
            layout='@layout/item_status' />

        <include
            android:id='@+id/rowNotif'
            layout='@layout/item_status' />

        <include
            android:id='@+id/rowHelper'
            layout='@layout/item_status' />

        <TextView
            android:layout_width='match_parent'
            android:layout_height='wrap_content'
            android:layout_marginTop='16dp'
            android:layout_marginBottom='12dp'
            android:text='Your status'
            android:textAppearance='?attr/textAppearanceTitleLarge'
            android:textColor='?attr/colorOnSurface'
            android:textStyle='bold' />

        <com.google.android.material.card.MaterialCardView
            style='@style/Widget.Material3.CardView.Filled'
            android:layout_width='match_parent'
            android:layout_height='wrap_content'
            app:cardBackgroundColor='?attr/colorTertiaryContainer'
            app:cardCornerRadius='28dp'
            app:cardElevation='0dp'>

            <LinearLayout
                android:layout_width='match_parent'
                android:layout_height='wrap_content'
                android:orientation='vertical'
                android:padding='22dp'>

                <TextView
                    android:id='@+id/statusValue'
                    android:layout_width='match_parent'
                    android:layout_height='wrap_content'
                    android:textAppearance='?attr/textAppearanceHeadlineSmall'
                    android:textColor='?attr/colorOnTertiaryContainer'
                    android:textStyle='bold' />

                <TextView
                    android:id='@+id/statusReply'
                    android:layout_width='match_parent'
                    android:layout_height='wrap_content'
                    android:layout_marginTop='8dp'
                    android:textAppearance='?attr/textAppearanceBodyLarge'
                    android:textColor='?attr/colorOnTertiaryContainer' />

                <com.google.android.material.button.MaterialButton
                    android:id='@+id/refreshStatus'
                    style='@style/Widget.Material3.Button.TextButton'
                    android:layout_width='wrap_content'
                    android:layout_height='wrap_content'
                    android:layout_gravity='end'
                    android:layout_marginTop='8dp'
                    android:text='Refresh' />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width='match_parent'
            android:layout_height='wrap_content'
            android:layout_marginTop='24dp'
            android:text='Stop only pauses replies. Notification access stays on in Android settings.'
            android:textAppearance='?attr/textAppearanceBodySmall'
            android:textColor='?attr/colorOnSurfaceVariant' />
    </LinearLayout>
</ScrollView>
